{
  "info": {
    "name": "MiJardín API - Pruebas Completas",
    "description": "Colección de Postman para probar todos los endpoints del backend FastAPI.\n\nPASOS PARA USAR:\n1. Importa este archivo en Postman (File > Import)\n2. Primero ejecuta 'Login Admin' para obtener el token\n3. Haz clic en la variable {{token}} en la barra superior y pega el token recibido\n4. Ya puedes probar todos los endpoints protegidos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🟢 0. RAÍZ - Verificar servidor",
      "item": [
        {
          "name": "GET / - Verificar que el servidor funciona",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/",
            "description": "Prueba básica: verifica que el backend FastAPI está corriendo."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🔵 1. AUTH - Registro de usuarios",
      "item": [
        {
          "name": "POST /register - Registrar cliente válido",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Juan Carlos\",\n  \"apellidos\": \"Pérez López\",\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"12345678\",\n  \"direccion\": \"Calle 10 #5-20 Medellín\",\n  \"telefono\": \"3001234567\",\n  \"email\": \"juan@test.com\",\n  \"password\": \"miPassword1\"\n}"
            },
            "description": "✅ Esperado: 201 Created con { success: true }"
          },
          "response": []
        },
        {
          "name": "POST /register - Error: correo duplicado",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Otro\",\n  \"apellidos\": \"Usuario\",\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"99999999\",\n  \"direccion\": \"Carrera 50 #20-10\",\n  \"telefono\": \"3109876543\",\n  \"email\": \"juan@test.com\",\n  \"password\": \"otraPass1\"\n}"
            },
            "description": "❌ Esperado: 409 Conflict - El correo ya está registrado"
          },
          "response": []
        },
        {
          "name": "POST /register - Error: contraseña corta",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Test\",\n  \"apellidos\": \"User\",\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"12345678\",\n  \"direccion\": \"Calle 10\",\n  \"telefono\": \"3001234567\",\n  \"email\": \"test@test.com\",\n  \"password\": \"123\"\n}"
            },
            "description": "❌ Esperado: 422 - La contraseña debe tener mínimo 9 caracteres"
          },
          "response": []
        },
        {
          "name": "POST /register - Error: teléfono inválido",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Test\",\n  \"apellidos\": \"User\",\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"12345678\",\n  \"direccion\": \"Calle 10\",\n  \"telefono\": \"123\",\n  \"email\": \"test2@test.com\",\n  \"password\": \"validPass1\"\n}"
            },
            "description": "❌ Esperado: 422 - El teléfono debe tener entre 7 y 10 dígitos"
          },
          "response": []
        },
        {
          "name": "POST /register - Error: nombre inválido (números)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"1234\",\n  \"apellidos\": \"User\",\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"12345678\",\n  \"direccion\": \"Calle 10\",\n  \"telefono\": \"3001234567\",\n  \"email\": \"test3@test.com\",\n  \"password\": \"validPass1\"\n}"
            },
            "description": "❌ Esperado: 422 - Solo se permiten letras, espacios, apóstrofes y guiones"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🟡 2. AUTH - Login y JWT",
      "item": [
        {
          "name": "POST /login - Login Admin (GUARDA EL TOKEN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('token', jsonData.token);",
                  "    pm.test('Token guardado correctamente', function () {",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "    });",
                  "    console.log('✅ Token guardado en variable de entorno: ' + jsonData.token.substring(0, 30) + '...');",
                  "} else {",
                  "    console.log('❌ No se recibió token');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@mijardin.com\",\n  \"password\": \"Admin1234\"\n}"
            },
            "description": "🔐 Login como Administrador. El token se guarda automáticamente en la variable {{token}}."
          },
          "response": []
        },
        {
          "name": "POST /login - Login Empleado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('token_empleado', jsonData.token);",
                  "    console.log('✅ Token de empleado guardado');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"empleado@mijardin.com\",\n  \"password\": \"Admin1234\"\n}"
            },
            "description": "🔐 Login como Empleado. Guarda el token en {{token_empleado}}."
          },
          "response": []
        },
        {
          "name": "POST /login - Login Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('token_cliente', jsonData.token);",
                  "    console.log('✅ Token de cliente guardado');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@mijardin.com\",\n  \"password\": \"Admin1234\"\n}"
            },
            "description": "🔐 Login como Cliente. Guarda el token en {{token_cliente}}."
          },
          "response": []
        },
        {
          "name": "POST /login - Error: credenciales inválidas",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"noexiste@test.com\",\n  \"password\": \"wrongpass\"\n}"
            },
            "description": "❌ Esperado: 401 - Credenciales inválidas"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🟣 3. AUTH - Verificar token (/me)",
      "item": [
        {
          "name": "GET /me - Verificar token válido",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "✅ Esperado: 200 con los datos del usuario decodificados del JWT"
          },
          "response": []
        },
        {
          "name": "GET /me - Error: sin token",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me",
            "description": "❌ Esperado: 403 - Not authenticated"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🔴 4. ADMIN - Gestión de usuarios (CRUD)",
      "item": [
        {
          "name": "GET /admin/users - Listar todos los usuarios",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/admin/users",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "✅ Lista todos los usuarios. Solo Administrador puede acceder."
          },
          "response": []
        },
        {
          "name": "POST /admin/users - Crear usuario Empleado",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/admin/users",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"María Elena\",\n  \"apellidos\": \"García López\",\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"87654321\",\n  \"direccion\": \"Carrera 50 #20-10 Medellín\",\n  \"telefono\": \"3109876543\",\n  \"email\": \"maria@test.com\",\n  \"password\": \"seguraPass1\",\n  \"rol_id\": 4\n}"
            },
            "description": "✅ Crea un usuario con rol Empleado (rol_id=4)"
          },
          "response": []
        },
        {
          "name": "PUT /admin/users/{id} - Editar usuario",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users/2",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "users", "2"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"María Elena\",\n  \"apellidos\": \"García Actualizado\",\n  \"estado\": \"activo\"\n}"
            },
            "description": "✅ Actualiza el usuario con id=2. Cambia nombre, apellido y estado."
          },
          "response": []
        },
        {
          "name": "PATCH /admin/users/{id}/estado - Cambiar estado a inactivo",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users/2/estado",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "users", "2", "estado"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"inactivo\"\n}"
            },
            "description": "✅ Cambia el estado del usuario 2 a 'inactivo'. Prueba también con 'activo'."
          },
          "response": []
        },
        {
          "name": "DELETE /admin/users/{id} - Eliminar usuario",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users/5",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "users", "5"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "✅ Elimina el usuario con id=5. Cambia el número según tu BD."
          },
          "response": []
        },
        {
          "name": "GET /admin/users - Error: sin token (no autenticado)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/admin/users",
            "description": "❌ Esperado: 403 - Not authenticated"
          },
          "response": []
        },
        {
          "name": "GET /admin/users - Error: token de cliente (sin permisos)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/admin/users",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
            ],
            "description": "❌ Esperado: 403 - No tienes permisos para realizar esta acción."
          },
          "response": []
        }
      ]
    },
