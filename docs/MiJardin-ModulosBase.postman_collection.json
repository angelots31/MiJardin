                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Devuelve el usuario del token. Cambia la cabecera por token_empleado o token_cliente para validar los otros roles."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test(\"Token válido\", () => pm.expect(datos.success).to.be.true);",
                  "pm.test(\"Devuelve el rol del usuario\", () => pm.expect(datos.usuario).to.have.property(\"rol_nombre\"));"
                ]
              }
            }
          ]
        }
      ]
